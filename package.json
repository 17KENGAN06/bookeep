{
  "name": "bookkeep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "dev:client": "vite --host --port 5173",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n client,server -c green,blue \"npm run dev:client\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "start:server": "npm run start --prefix server",
    "lint": "oxlint",
    "preview": "vite preview --host --port 4173"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "react-pdf": "^11.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
