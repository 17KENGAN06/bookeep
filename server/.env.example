PORT=4000
# Comma-separated site origins allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Public Supabase values served to the site via GET /api/config.
# On Railway set these in the service Variables. Never put the service role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Gemini API key (Google AI Studio) for POST /api/explain: selected-text explanations
# in the reader. On Railway set it in the service Variables. Never put it in the frontend .env.
GEMINI_API_KEY=
# Optional: pin a model instead of the current Flash alias.
# GEMINI_MODEL=gemini-flash-latest
# Optional: requests per reader IP per 10 minutes (default 40).
# EXPLAIN_LIMIT_PER_10MIN=40

# Server-only Supabase key (Supabase → Project Settings → API Keys → secret / service_role).
# Lets the server check sign-ins, write subscriptions from the Stripe webhook and count
# explanation requests. Never put it in the site's .env.
# New Supabase keys (sb_secret_...) can go in SUPABASE_SECRET_KEY instead; either name works.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard → Developers → API keys / Webhooks; Product catalog → price id).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: free trial length in days for a new subscriber (default 3, once per account).
# STRIPE_TRIAL_DAYS=3
# Where Stripe sends the reader back after paying (default: first CLIENT_ORIGIN).
# SITE_URL=https://bookeep.cloud

# Optional: explanations per day (default guest 5 per IP, free account 15, subscriber 60).
# EXPLAIN_DAILY_GUEST=5
# EXPLAIN_DAILY_FREE=15
# EXPLAIN_DAILY_PREMIUM=60
