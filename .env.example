# Frontend. Copy to .env for local dev. Never put the Supabase service role key here.
# Hostinger builds use the committed .env.production and load the Supabase config
# from the Railway API (/api/config) when the VITE_SUPABASE_* vars are empty.

# Public site origin for canonical URLs, Open Graph, robots.txt and sitemap.
# Example: https://bookeep.cloud
VITE_SITE_URL=https://bookeep.cloud

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy name still works:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Railway API. Locally leave empty to use the Vite /api proxy.
# Production value lives in .env.production: https://api.bookeep.cloud
VITE_API_URL=
