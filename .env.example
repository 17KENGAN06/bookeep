# Frontend (Hostinger). Copy to .env before `npm run build`.
# Never put the Supabase service role key here.

# Public site origin for canonical URLs, Open Graph, robots.txt and sitemap.
# Example: https://bookkeep.yourdomain.com
VITE_SITE_URL=

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy name still works:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Railway API. Locally leave empty to use the Vite /api proxy.
# After Railway deploy, set this to the public Railway URL, e.g. https://bookkeep-server.up.railway.app
VITE_API_URL=
